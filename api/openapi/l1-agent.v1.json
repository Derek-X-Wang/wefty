{
  "openapi": "3.1.0",
  "info": {
    "title": "Wefty L1 agent protocol",
    "version": "0.1.0-prerelease",
    "description": "Fabric-authenticated node registration, liveness, claim, lease, log, and completion protocol."
  },
  "servers": [{ "url": "wefty://control-plane" }],
  "security": [{ "fabricIdentity": [] }],
  "paths": {
    "/v1/agent/nodes/register": {
      "post": {
        "operationId": "registerNode",
        "summary": "Register a stable node and per-boot session",
        "description": "The request cannot self-report tags. The response includes authoritative tags derived from Fabric identity and operator configuration.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./common.v1.json#/components/schemas/NodeRegistration" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Node boot session registered.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Node" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/nodes/{node_id}/heartbeat": {
      "parameters": [
        { "name": "node_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "heartbeatNode",
        "summary": "Update liveness and capabilities, then receive node-scoped directives",
        "description": "Boot-session-scoped and never attempt-authority-generation-fenced. Capability replacement, liveness, and effective capacity commit atomically without changing durable claim intent. The response carries claim intent, effective class capacities, and pending removal directives even when the node owns no attempt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "boot_session_id", "capabilities", "capability_revision",
                  "capability_observed_at", "missing_capabilities"
                ],
                "properties": {
                  "boot_session_id": { "type": "string" },
                  "capabilities": {
                    "type": "object",
                    "maxProperties": 128,
                    "propertyNames": { "minLength": 1, "maxLength": 128 },
                    "additionalProperties": { "type": "boolean" }
                  },
                  "capability_revision": { "type": "integer", "minimum": 1 },
                  "capability_observed_at": { "type": "string", "format": "date-time" },
                  "missing_capabilities": {
                    "type": "array",
                    "maxItems": 128,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1, "maxLength": 128 }
                  },
                  "capability_reason_code": {
                    "type": "string",
                    "enum": [
                      "oci_intent_disabled", "prerequisite_missing", "runtime_version_unsupported",
                      "helper_unreachable", "helper_version_mismatch", "helper_handshake_failed",
                      "boot_sweep_failed", "probe_failed", "lima_stopped", "lima_broken",
                      "lima_start_timeout", "template_restart_required", "template_recreate_required",
                      "mount_root_unavailable", "local_permission_denied"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Node liveness updated and the current node-scoped intent channel returned.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/HeartbeatResponse" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/nodes/{node_id}/drain": {
      "parameters": [
        { "name": "node_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "drainNode",
        "summary": "Drain this agent boot session for graceful shutdown",
        "description": "Changes boot-session liveness to draining without mutating durable operator claim intent or fencing existing attempts. Fenced attempt completions continue through the ordinary completion route.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["boot_session_id"],
                "properties": {
                  "boot_session_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Node is draining; existing attempt authority remains valid.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Node" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/jobs/claim": {
      "post": {
        "operationId": "claimJob",
        "summary": "Atomically claim one eligible queued job in one workload class",
        "description": "Eligibility, class capacity, service binding, and agent-local job exclusions are evaluated inside the claim transaction using authenticated authoritative node policy. Exclusions prevent this boot session from re-claiming a job whose prior attempt is still being finalized locally. The request intentionally contains no tags or capacity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node_id", "boot_session_id", "class"],
                "properties": {
                  "node_id": { "type": "string" },
                  "boot_session_id": { "type": "string" },
                  "class": { "type": "string", "enum": ["one-shot", "service"] },
                  "excluded_job_ids": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "uniqueItems": true,
                    "description": "Jobs still resident in this agent boot through process, log, completion, renewal, or handoff finalization."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Claim won; attempt, fence, and lease were created atomically.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["job", "lease"],
                  "properties": {
                    "job": { "$ref": "./common.v1.json#/components/schemas/Job" },
                    "lease": { "$ref": "./common.v1.json#/components/schemas/AttemptLease" },
                    "prestart_deadline": {
                      "type": "string",
                      "format": "date-time",
                      "description": "One-shot OCI only. Absolute persisted deadline shared by every pre-Started attempt and used to clamp agent-owned image delivery policy."
                    },
                    "computer_storage": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["computer_id", "storage_id", "storage_generation", "intent_revision"],
                      "properties": {
                        "computer_id": { "type": "string", "minLength": 1 },
                        "storage_id": { "type": "string", "minLength": 1 },
                        "storage_generation": { "type": "integer", "format": "int64", "minimum": 1 },
                        "intent_revision": { "type": "integer", "format": "int64", "minimum": 1 }
                      },
                      "description": "Computer claims only. Exact durable Storage identity authorized by the current immutable Job projection."
                    }
                  }
                }
              }
            }
          },
          "204": { "description": "No eligible queued job." },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/jobs/{job_id}/attempts/{attempt_id}/lease": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "attempt_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "renewAttemptLease",
        "summary": "Renew one attempt lease",
        "description": "Distinct from node heartbeat. A success returns a duration TTL and any attempt-scoped service directive; stale fence, attempt mismatch, or expiry returns 409 without granting write authority.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fencing_token"],
                "properties": {
                  "fencing_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lease renewed with a duration TTL and any stop or restart directive for this payload.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/AttemptLease" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/jobs/{job_id}/attempts/{attempt_id}/publication": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "attempt_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "put": {
        "operationId": "setAttemptPublication",
        "summary": "Set absolute publication state for one portful service attempt",
        "description": "L1 derives the immutable published port from the service specification. The mutation is authorized in fenced-write order, is not replayable after terminalization, and leaves the database untouched when the stored publication already equals the requested state.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fencing_token", "ready"],
                "properties": {
                  "fencing_token": { "type": "string", "minLength": 1 },
                  "ready": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Publication changed or was already in the requested state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Job" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/jobs/{job_id}/attempts/{attempt_id}/image": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "attempt_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "put": {
        "operationId": "observeAttemptImage",
        "summary": "Record one fenced, write-once OCI image observation",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fencing_token", "submitted_reference", "top_level_digest", "top_level_media_type", "platform_manifest_digest", "platform", "runtime_handler", "snapshotter"],
            "properties": {
              "fencing_token": { "type": "string", "minLength": 1 },
              "submitted_reference": { "type": "string", "minLength": 1 },
              "top_level_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "top_level_media_type": { "type": "string", "minLength": 1 },
              "index_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
              "platform_manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "platform": { "$ref": "./common.v1.json#/components/schemas/OCIPlatformEvidence" },
              "runtime_handler": { "type": "string", "minLength": 1 },
              "snapshotter": { "type": "string", "minLength": 1 }
            }
          } } }
        },
        "responses": {
          "200": { "description": "Observation accepted or identically replayed.", "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Job" } } } },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/jobs/{job_id}/attempts/{attempt_id}/started": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "attempt_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "startAttempt",
        "summary": "Acknowledge authoritative OCI Started idempotently",
        "description": "This is the sole claimed-to-running transition for OCI attempts.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": {
          "type": "object", "additionalProperties": false, "required": ["fencing_token"],
          "properties": { "fencing_token": { "type": "string", "minLength": 1 } }
        } } } },
        "responses": {
          "200": { "description": "Started accepted or identically replayed.", "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Job" } } } },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/jobs/{job_id}/attempts/{attempt_id}/logs": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "attempt_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "appendAttemptLogs",
        "summary": "Append an idempotent batch of per-stream log events",
        "description": "L1 is the sole owner of idempotency for (attempt_id, stream, sequence). Identical replay is acknowledged without duplication; conflicting replay or an undeclared sequence gap is rejected. Raw byte chunks are not scanned or decoded as lines. Lost attempts accept in-sequence evidence by original job/node/attempt/fence provenance during the late-evidence window without changing verdict or authority; after that window raw events become truthful per-stream gap records.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fencing_token", "events"],
                "properties": {
                  "fencing_token": { "type": "string" },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "items": { "$ref": "./common.v1.json#/components/schemas/LogEvent" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch accepted or identically replayed. Ack sequences are per stream and are upload acknowledgements, not reader cursors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["acknowledged"],
                  "properties": {
                    "acknowledged": {
                      "type": "object",
                      "additionalProperties": { "type": "integer", "minimum": 0 },
                      "example": { "stdout": 12, "stderr": 7 }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/jobs/{job_id}/attempts/{attempt_id}/complete": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "attempt_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "completeAttempt",
        "summary": "Complete one attempt idempotently",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fencing_token", "idempotency_key", "result"],
                "properties": {
                  "fencing_token": { "type": "string" },
                  "idempotency_key": { "type": "string", "minLength": 1 },
                  "result": { "$ref": "./common.v1.json#/components/schemas/ProcessResult" },
                  "runtime_quiescence_evidence": {
                    "type": "string",
                    "enum": ["attempt", "no_runtime_resources", "oci_sweep", "prior_boot_guardian", "prior_boot_oci_sweep"]
                  },
                  "protocol_output_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completion accepted or identically replayed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Job" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/agent/jobs/{job_id}/removal-acknowledgement": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "acknowledgeServiceRemoval",
        "summary": "Attest that bound service cleanup completed",
        "description": "Acknowledgement strictly follows local deletion. L1 validates Fabric identity, current boot session, bound node, generation, opaque cleanup fence, root-instance ID, idempotency key, and body hash in one transaction, then finalizes the tombstone in a separate crash-recoverable transaction.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node_id", "boot_session_id", "removal_generation", "cleanup_fence", "root_instance_id", "idempotency_key"],
                "properties": {
                  "node_id": { "type": "string", "minLength": 1 },
                  "boot_session_id": { "type": "string", "minLength": 1 },
                  "removal_generation": { "type": "integer", "minimum": 1 },
                  "cleanup_fence": { "type": "string", "minLength": 1 },
                  "root_instance_id": { "type": "string", "minLength": 1 },
                  "idempotency_key": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deletion attestation accepted, identically replayed, or already finalized without mutation.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Job" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/agent/computers/{computer_id}/storage-reset-acknowledgement": {
      "parameters": [
        { "name": "computer_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "acknowledgeComputerStorageReset",
        "summary": "Attest that one old Storage generation is absent",
        "description": "The authenticated current node submits a helper-derived receipt bound to Computer, Storage, old/new generations, Job, reset intent revision, cleanup fence, and helper generation. L1 first commits verification, then separately publishes generation+1 so a crash at that boundary resumes without deleting twice or attaching early.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "boot_session_id", "idempotency_key", "receipt"],
            "properties": {
              "node_id": { "type": "string", "minLength": 1 },
              "boot_session_id": { "type": "string", "minLength": 1 },
              "idempotency_key": { "type": "string", "minLength": 1 },
              "receipt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind", "receipt_id", "computer_id", "storage_id", "old_generation",
                  "new_generation", "node_id", "job_id", "intent_revision", "cleanup_fence",
                  "helper_generation"
                ],
                "properties": {
                  "kind": { "const": "computer_storage_reset_verified" },
                  "receipt_id": { "type": "string", "minLength": 1 },
                  "computer_id": { "type": "string", "minLength": 1 },
                  "storage_id": { "type": "string", "minLength": 1 },
                  "old_generation": { "type": "integer", "format": "int64", "minimum": 1 },
                  "new_generation": { "type": "integer", "format": "int64", "minimum": 2 },
                  "node_id": { "type": "string", "minLength": 1 },
                  "job_id": { "type": "string", "minLength": 1 },
                  "intent_revision": { "type": "integer", "format": "int64", "minimum": 1 },
                  "cleanup_fence": { "type": "string", "minLength": 1 },
                  "helper_generation": { "type": "integer", "minimum": 1 }
                }
              }
            }
          } } }
        },
        "responses": {
          "200": {
            "description": "Verification accepted or identically replayed; the returned Computer shows whether publication completed.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    }
  },
