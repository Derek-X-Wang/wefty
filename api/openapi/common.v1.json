{
  "openapi": "3.1.0",
  "info": {
    "title": "Wefty shared protocol components",
    "version": "0.1.0-prerelease"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/Error" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code."
          },
          "message": { "type": "string" },
          "retryable": {
            "type": "boolean",
            "description": "Advises whether repeating the same request may succeed. A known authority-loss code always governs the caller's reaction."
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "request_id": { "type": "string" }
        }
      },
      "JobSpec": {
        "$ref": "../../contract/schemas/v1/job-spec.schema.json",
        "description": "Open-kind workload contract. kind=process uses the flat process execution fields; kind=oci uses execution.oci while env and sensitive_env remain shared."
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "state", "created_at", "updated_at"],
        "properties": {
          "job_id": { "type": "string" },
          "node_id": { "type": "string", "description": "Stable node ID for the current or latest attempt. This is not the durable service binding." },
          "state": {
            "enum": ["queued", "claimed", "running", "stopping", "stopped", "awaiting-input", "succeeded", "failed", "removal_pending", "agent_cleaned", "removed_verified", "forgotten_cleanup_unverified"]
          },
          "status": {
            "type": "string",
            "description": "Service jobs only. Computed operator projection; may be restart-pending or unschedulable while persisted state remains queued."
          },
          "spec": {
            "$ref": "#/components/schemas/JobSpec",
            "description": "Absent after removal finalizes; tombstones retain no executable or environment bytes."
          },
          "current_attempt_id": { "type": "string" },
          "attempts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Attempt" },
            "description": "Retained operator-safe attempt summaries in chronological order. Write-authority fields are never exposed."
          },
          "desired_state": {
            "enum": ["running", "stopped", "removed"],
            "description": "Service jobs only. Requested lifecycle target, distinct from observed state."
          },
          "bound_node_id": {
            "type": "string",
            "description": "Service jobs only. Durable service binding, retained independently of node_id."
          },
          "node_state": {
            "enum": ["alive", "stale", "draining", "dead"],
            "description": "Service jobs only. Current liveness of the bound node."
          },
          "holds_slot": {
            "type": "boolean",
            "description": "Service jobs only. Whether the binding currently occupies one service slot."
          },
          "unschedulable_reason": {
            "type": "string",
            "description": "Present when computed status is unschedulable; names the placement or capacity fact preventing claim."
          },
          "restart_suppressed_reason": {
            "type": "string",
            "description": "Present when durable desired state or a failed latch suppresses automatic restart."
          },
          "restart_streak": { "type": "integer", "minimum": 0 },
          "lifetime_restart_count": { "type": "integer", "minimum": 0 },
          "next_restart_at": { "type": "string", "format": "date-time" },
          "published_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Service jobs only. Ready publication endpoint; absent unless ready is true. The immutable requested port remains in spec.published_port."
          },
          "ready": {
            "type": "boolean",
            "description": "Portful service jobs only. True only while the current attempt has active authoritative publication; omitted for portless services."
          },
          "last_failure": {},
          "healthy_since_at": { "type": "string", "format": "date-time" },
          "removal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["desired_state", "removal_generation", "removal_requested_at"],
            "properties": {
              "desired_state": { "const": "removed" },
              "bound_node_id": { "type": "string" },
              "removal_generation": { "type": "integer", "minimum": 1 },
              "removal_requested_at": { "type": "string", "format": "date-time" },
              "removal_outcome": { "enum": ["verified_removed", "force_forgotten"] },
              "removed_at": { "type": "string", "format": "date-time" },
              "cleanup_acknowledged_at": {
                "type": "string",
                "format": "date-time",
                "description": "Present only when a bound agent attested deletion. A verified unbound removal omits it because no managed resource ever existed."
              }
            }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Attempt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "node_id", "state", "lease_expires_at", "created_at", "updated_at"],
        "properties": {
          "attempt_id": { "type": "string" },
          "node_id": { "type": "string" },
          "state": { "enum": ["claimed", "running", "awaiting-input", "succeeded", "failed", "lost"] },
          "lease_expires_at": { "type": "string", "format": "date-time" },
          "result": { "$ref": "#/components/schemas/ProcessResult" },
          "late_result": { "$ref": "#/components/schemas/LateResultEvidence" },
          "image": { "$ref": "#/components/schemas/OCIImageEvidence" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "LateResultEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "late", "observed_at", "authority_lost_at"],
        "properties": {
          "kind": { "enum": ["observation", "gap"] },
          "result": { "$ref": "#/components/schemas/ProcessResult" },
          "gap": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": { "reason": { "const": "observation_window_expired" } }
          },
          "late": { "const": true },
          "observed_at": { "type": "string", "format": "date-time" },
          "authority_lost_at": { "type": "string", "format": "date-time" }
        },
        "oneOf": [
          { "properties": { "kind": { "const": "observation" } }, "required": ["result"], "not": { "required": ["gap"] } },
          { "properties": { "kind": { "const": "gap" } }, "required": ["gap"], "not": { "required": ["result"] } }
        ]
      },
      "AttemptLease": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "fencing_token", "lease_expires_at", "lease_ttl"],
        "properties": {
          "attempt_id": { "type": "string" },
          "fencing_token": {
            "type": "string",
            "description": "Opaque monotonically increasing per-job fence; never parse as a number."
          },
          "lease_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Compatibility wall-clock expiry. Agents use lease_ttl after the resilience cutover."
          },
          "lease_ttl": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Granted lease duration in nanoseconds. The agent measures it from its monotonic request start, without comparing clocks."
          },
          "directive": {
            "enum": ["stop", "restart"],
            "description": "Attempt-scoped service intent. Omission means no lifecycle change is requested."
          }
        }
      },
      "LogGap": {
        "type": "object",
        "additionalProperties": false,
        "required": ["through_sequence", "lost_event_count", "lost_byte_count", "reason"],
        "properties": {
          "through_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "Inclusive last sequence covered by this per-stream gap. LogEvent.sequence is the first covered sequence."
          },
          "lost_event_count": { "type": "integer", "minimum": 1 },
          "lost_byte_count": { "type": "integer", "minimum": 1 },
          "reason": {
            "enum": ["spool_eviction", "oversized_event", "replay_rejected", "late_evidence_window_expired"]
          },
          "source_event_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Present when L1 replaces an out-of-window event with a gap so exact replay remains distinguishable from conflicting payloads."
          }
        },
        "description": "A truthful declaration that raw log events from exactly one stream are unavailable. A source event larger than the entire service spool budget is converted whole into one oversized_event gap; it is not partially retained or chunked at eviction time."
      },
      "LogEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "stream", "sequence", "timestamp"],
        "oneOf": [
          { "required": ["bytes"], "not": { "required": ["gap"] } },
          { "required": ["gap"], "not": { "required": ["bytes"] } }
        ],
        "properties": {
          "attempt_id": { "type": "string" },
          "stream": { "enum": ["stdout", "stderr"] },
          "sequence": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "timestamp": { "type": "string", "format": "date-time" },
          "bytes": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "One non-empty raw byte chunk, up to 4 MiB before base64 encoding. Chunks are not lines: values may exceed 64 KiB, end with a partial line, or contain invalid UTF-8. Ordering is guaranteed per attempt and stream only."
          },
          "gap": { "$ref": "#/components/schemas/LogGap" }
        },
        "description": "One ordered raw chunk or gap declaration. Continuity and gap ranges are independent for stdout and stderr."
      },
      "ServiceLogTruncation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bound_kind", "evicted_event_count", "evicted_byte_count", "evicted_through_ordinal", "earliest_retained_at", "updated_at"],
        "properties": {
          "bound_kind": {
            "enum": ["bytes", "age"],
            "description": "The retention bound that most recently caused eviction."
          },
          "evicted_event_count": { "type": "integer", "minimum": 0 },
          "evicted_byte_count": { "type": "integer", "minimum": 0 },
          "evicted_through_ordinal": {
            "type": "integer",
            "minimum": 0,
            "description": "Internal monotonic ordering watermark; clients must not use it as a reader cursor."
          },
          "earliest_retained_at": { "type": ["string", "null"], "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "description": "One aggregate L1 history-truncation marker per service job. This is distinct from LogGap, which declares loss before L1 accepted evidence."
      },
      "ProcessResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "spawn_error": { "$ref": "#/components/schemas/SpawnFailure" },
          "runtime_failure": { "$ref": "#/components/schemas/RuntimeFailure" },
          "output_error": {
            "type": "string",
            "description": "Output redaction, durable spooling, or upload finalization failed; the process exit code is not authoritative success."
          },
          "exit_code": { "type": "integer" },
          "signal": { "type": "string" },
          "termination_cause": {
            "enum": ["spontaneous", "agent", "guardian"],
            "description": "Structured initiator for a signal termination; never infer intent from signal or error strings."
          },
          "oom": {
            "type": "boolean",
            "description": "Additive runtime evidence. It does not select a primary result arm and is never inferred from exit 137."
          }
        },
        "dependentRequired": {
          "signal": ["termination_cause"],
          "termination_cause": ["signal"]
        },
        "oneOf": [
          { "required": ["spawn_error"] },
          { "required": ["runtime_failure"] },
          { "required": ["output_error"] },
          { "required": ["exit_code"] },
          { "required": ["signal", "termination_cause"] }
        ]
      },
      "SpawnFailure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Stable machine-readable spawn failure code. Unknown codes default to terminal service policy."
          },
          "message": { "type": "string", "minLength": 1 }
        }
      },
      "RuntimeFailure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Stable post-Started runtime failure code. Unknown codes default terminal."
          },
          "message": { "type": "string", "minLength": 1 }
        }
      },
      "OCIPlatformEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "architecture"],
        "properties": {
          "os": { "type": "string", "minLength": 1 },
          "architecture": { "type": "string", "minLength": 1 },
          "variant": { "type": "string" }
        }
      },
      "OCIImageEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["submitted_reference", "top_level_digest", "top_level_media_type", "index_digest", "platform_manifest_digest", "platform", "runtime_handler", "snapshotter", "resolved_at"],
        "properties": {
          "submitted_reference": { "type": "string", "minLength": 1 },
          "top_level_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "top_level_media_type": { "type": "string", "minLength": 1 },
          "index_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "platform_manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "platform": { "$ref": "#/components/schemas/OCIPlatformEvidence" },
          "runtime_handler": { "type": "string", "minLength": 1 },
          "snapshotter": { "type": "string", "minLength": 1 },
          "resolved_at": { "type": "string", "format": "date-time" },
          "started_at": { "type": "string", "format": "date-time" }
        }
      },
      "LogPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["events", "next_cursor"],
        "properties": {
          "events": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LogEvent" }
          },
          "next_cursor": {
            "type": "string",
            "description": "Opaque cursor; clients must not infer SQLite row IDs."
          },
          "truncation": { "$ref": "#/components/schemas/ServiceLogTruncation" }
        }
      },
      "NodeRegistration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "boot_session_id", "os", "architecture", "agent_version"],
        "properties": {
          "node_id": { "type": "string" },
          "boot_session_id": { "type": "string" },
          "connect_host": {
            "type": "string",
            "description": "Fabric-produced hostname for combining with a published port. Descriptive only; never an identity, authorization, or scheduling input."
          },
          "root_instance_id": {
            "type": "string",
            "description": "Self-reported identity of the node's current agent-owned managed resource root. Descriptive only; never an eligibility or scheduling input."
          },
          "os": { "type": "string" },
          "architecture": { "type": "string" },
          "agent_version": { "type": "string" },
          "capabilities": {
            "type": "object",
            "additionalProperties": { "type": "boolean" },
            "description": "Executable support only. max_oneshot_slots and max_service_slots are reserved control-plane policy keys and are rejected."
          }
        },
        "description": "No tags or capacity fields are accepted. Eligibility policy comes from operator-owned control-plane configuration; connect_host is a non-authoritative Fabric projection."
      },
      "RemovalDirective": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "bound_node_id", "removal_generation", "cleanup_fence", "root_instance_id"],
        "properties": {
          "job_id": { "type": "string" },
          "bound_node_id": { "type": "string" },
          "removal_generation": { "type": "integer", "minimum": 1 },
          "cleanup_fence": { "type": "string", "minLength": 1 },
          "root_instance_id": { "type": "string", "minLength": 1 }
        }
      },
      "Node": {
        "allOf": [
          { "$ref": "#/components/schemas/NodeRegistration" },
          {
            "type": "object",
            "required": [
              "state", "authoritative_tags", "max_oneshot_slots", "max_service_slots",
              "oneshot_occupancy", "service_occupancy", "overcommitted",
              "authority_generation", "claims_enabled", "intent_revision", "intent_reason",
              "intent_updated_at", "intent_actor", "last_heartbeat_at"
            ],
            "properties": {
              "state": { "enum": ["alive", "stale", "draining", "dead"] },
              "authoritative_tags": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true,
                "readOnly": true
              },
              "max_oneshot_slots": {
                "type": "integer",
                "minimum": 0,
                "readOnly": true
              },
              "max_service_slots": {
                "type": "integer",
                "minimum": 0,
                "readOnly": true
              },
              "oneshot_occupancy": {
                "type": "integer",
                "minimum": 0,
                "readOnly": true,
                "description": "Current one-shot slot occupancy from non-terminal one-shot attempts."
              },
              "service_occupancy": {
                "type": "integer",
                "minimum": 0,
                "readOnly": true,
                "description": "Current service slot occupancy from durable service bindings."
              },
              "overcommitted": {
                "type": "boolean",
                "readOnly": true,
                "description": "True when either class occupancy exceeds its effective configured limit; resident workloads are not killed."
              },
              "authority_generation": {
                "type": "integer",
                "minimum": 1,
                "readOnly": true,
                "description": "Monotonic registration generation bound into new attempts."
              },
              "claims_enabled": {
                "type": "boolean",
                "readOnly": true,
                "description": "Durable operator intent controlling admission of new claims."
              },
              "intent_revision": {
                "type": "integer",
                "minimum": 0,
                "readOnly": true
              },
              "intent_reason": { "type": "string", "readOnly": true },
              "intent_updated_at": {
                "type": ["string", "null"],
                "format": "date-time",
                "readOnly": true
              },
              "intent_actor": { "type": "string", "readOnly": true },
              "last_heartbeat_at": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "HeartbeatResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/Node" },
          {
            "type": "object",
            "required": ["removal_directives"],
            "properties": {
              "removal_directives": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/RemovalDirective" },
                "readOnly": true,
                "description": "Boot-session-scoped standing cleanup directives, including when no attempt is live."
              }
            }
          }
        ]
      },
      "RunRecord": {
        "$ref": "../../contract/schemas/v1/run-record.schema.json"
      },
      "Envelope": {
        "$ref": "../../contract/schemas/v1/envelope.schema.json"
      },
      "GateResult": {
        "$ref": "../../contract/schemas/v1/gate-result.schema.json"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed or invalid request.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated principal is outside its scope.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "State, fence, lease, dispatch key, or idempotency conflict.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Syntactically valid contract data cannot be executed, such as an unsupported kind.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotImplemented": {
        "description": "Reserved contract surface. Always returns code not_implemented and retryable false in v0.1.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Internal": {
        "description": "Unexpected server failure.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "securitySchemes": {
      "fabricIdentity": {
        "type": "mutualTLS",
        "description": "Identity supplied by the selected Fabric implementation."
      },
      "runToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque scoped run token"
      }
    }
  }
}
