{
  "openapi": "3.1.0",
  "info": {
    "title": "Wefty L1 client protocol",
    "version": "0.1.0-prerelease",
    "description": "Fabric-authenticated job submission and polling surface for client principals. Agent-only mutation verbs are in l1-agent.v1.json."
  },
  "servers": [{ "url": "wefty://control-plane" }],
  "security": [{ "fabricIdentity": [] }],
  "paths": {
    "/v1/jobs": {
      "post": {
        "operationId": "createJob",
        "summary": "Create a job idempotently by dispatch key",
        "description": "A new dispatch_key returns 201. An identical replay returns the original job with 200. Reuse with a different canonical request returns 409 dispatch_key_conflict. A Computer-trait spec must use /v1/computers so the durable authority and first immutable Job are committed together; bare creation returns computer_resource_required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./common.v1.json#/components/schemas/JobSpec" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical dispatch-key replay; original job returned.",
            "headers": {
              "Idempotency-Replayed": { "schema": { "type": "boolean", "const": true } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Job" }
              }
            }
          },
          "201": {
            "description": "Job created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Job" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "422": { "$ref": "./common.v1.json#/components/responses/UnprocessableEntity" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      },
      "get": {
        "operationId": "listServiceJobs",
        "summary": "List service-class jobs",
        "description": "Returns active service jobs in stable creation/job-ID order. Bare collection reads are invalid; class=service is mechanically required.",
        "parameters": [
          { "name": "class", "in": "query", "required": true, "schema": { "const": "service" } },
          { "name": "cursor", "in": "query", "description": "Opaque cursor returned by the previous page.", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 } }
        ],
        "responses": {
          "200": {
            "description": "One stable page of active service jobs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["jobs"],
                  "properties": {
                    "jobs": { "type": "array", "items": { "$ref": "./common.v1.json#/components/schemas/Job" } },
                    "next_cursor": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "operationId": "getJob",
        "summary": "Read service job status",
        "parameters": [
          { "name": "class", "in": "query", "required": true, "schema": { "const": "service" } }
        ],
        "responses": {
          "200": {
            "description": "Current job record.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Job" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" }
        }
      }
    },
    "/v1/jobs/{job_id}/logs": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "operationId": "getJobLogs",
        "summary": "Poll ordered job logs",
        "parameters": [
          { "name": "class", "in": "query", "required": true, "schema": { "const": "service" } },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor returned by the previous page.",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 }
          }
        ],
        "responses": {
          "200": {
            "description": "Log page from authoritative event rows, with an aggregate service-retention marker when history was evicted. Ordering is per attempt and stream only; next_cursor is unrelated to agent upload acknowledgements.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/LogPage" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" }
        }
      }
    },
    "/v1/jobs/{job_id}/desired-state": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "put": {
        "operationId": "setServiceDesiredState",
        "summary": "Start or stop a service by setting durable desired state",
        "description": "The mutation is idempotent and asynchronous. Running does not disturb a healthy attempt; a latched failed service rejects start and requires restart.",
        "parameters": [
          { "name": "class", "in": "query", "required": true, "schema": { "const": "service" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["desired_state"],
                "properties": {
                  "desired_state": { "enum": ["running", "stopped"] }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Desired state accepted; observed state may still be converging.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Job" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/jobs/{job_id}/restart": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "restartService",
        "summary": "Explicitly restart a service under the same job identity",
        "description": "Durably idempotent. Clears the failed latch, restart streak, last failure, and pending backoff, and directs any active attempt to stop before a fresh attempt is claimed.",
        "parameters": [
          { "name": "class", "in": "query", "required": true, "schema": { "const": "service" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["idempotency_key"],
                "properties": {
                  "idempotency_key": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical restart replay; no second restart was issued.",
            "headers": { "Idempotency-Replayed": { "schema": { "type": "boolean", "const": true } } },
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Job" } } }
          },
          "202": {
            "description": "Restart accepted.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Job" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/jobs/{job_id}/remove": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "removeService",
        "summary": "Irreversibly request service removal",
        "description": "Idempotent and asynchronous in every service state. The controller transaction revokes execution authority and scrubs SensitiveEnv plus controller logs before returning. A never-bound service finalizes immediately because no managed resource could exist.",
        "parameters": [
          { "name": "class", "in": "query", "required": true, "schema": { "const": "service" } }
        ],
        "responses": {
          "202": {
            "description": "Removal is pending agent attestation, or is already terminal.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Job" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/jobs/{job_id}/forget": {
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "forceForgetService",
        "summary": "Waive service cleanup verification",
        "description": "Permanently records forgotten_cleanup_unverified without cancelling the standing deletion directive and without invoking local deletion.",
        "parameters": [
          { "name": "class", "in": "query", "required": true, "schema": { "const": "service" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["force"],
                "properties": { "force": { "const": true } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cleanup proof waived; the unverified outcome is permanent.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Job" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/computers": {
      "post": {
        "operationId": "createComputer",
        "summary": "Create a durable Computer and its first immutable Job projection",
        "description": "The JobSpec dispatch key makes creation idempotent. Computer identity, storage identity, desired state, authenticated Fabric actor, and intent history are committed atomically with the first Job; bare Computer-trait Job creation is rejected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "spec"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 255 },
                  "spec": { "$ref": "./common.v1.json#/components/schemas/JobSpec" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical dispatch-key replay; the original Computer is returned.",
            "headers": { "Idempotency-Replayed": { "schema": { "type": "boolean", "const": true } } },
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "201": {
            "description": "Computer and initial Job projection created.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/computers/{computer_id}": {
      "parameters": [
        { "name": "computer_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "getComputer",
        "summary": "Read durable Computer intent and its current Job observation",
        "responses": {
          "200": {
            "description": "Current Computer authority and observation.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/computers/{computer_id}/intents": {
      "parameters": [
        { "name": "computer_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "listComputerIntents",
        "summary": "Page immutable Computer intent history",
        "description": "Actor identity is derived from the authenticated Fabric principal and cannot be supplied by the client.",
        "parameters": [
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 } }
        ],
        "responses": {
          "200": {
            "description": "One bounded intent-history page in revision order.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/ComputerIntentList" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/computers/{computer_id}/desired-state": {
      "parameters": [
        { "name": "computer_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "put": {
        "operationId": "setComputerDesiredState",
        "summary": "Start or stop a Computer under intent and Storage CAS",
        "description": "The Computer is the sole desired-state authority. A stale intent revision or storage reference is a typed conflict and performs no write.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["desired_state", "intent_revision", "storage_id", "storage_generation"],
            "properties": {
              "desired_state": { "enum": ["running", "stopped"] },
              "intent_revision": { "type": "integer", "minimum": 1 },
              "storage_id": { "type": "string", "minLength": 1 },
              "storage_generation": { "type": "integer", "minimum": 1 }
            }
          } } }
        },
        "responses": {
          "202": {
            "description": "Intent accepted; current_job carries the distinct observed lifecycle state.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/computers/{computer_id}/restart": {
      "parameters": [
        { "name": "computer_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "restartComputer",
        "summary": "Restart a stopped or latched-failed Computer",
        "description": "CAS-guarded and durably idempotent. The current immutable Job remains the observation, while the Computer authorizes a fresh attempt and retains binding, Storage identity, grants, and image pin.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intent_revision", "storage_id", "storage_generation", "idempotency_key"],
            "properties": {
              "intent_revision": { "type": "integer", "minimum": 1 },
              "storage_id": { "type": "string", "minLength": 1 },
              "storage_generation": { "type": "integer", "minimum": 1 },
              "idempotency_key": { "type": "string", "minLength": 1 }
            }
          } } }
        },
        "responses": {
          "200": {
            "description": "Identical restart replay; no second intent or attempt was issued.",
            "headers": { "Idempotency-Replayed": { "schema": { "type": "boolean", "const": true } } },
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "202": {
            "description": "Restart intent accepted and applied to the current Job projection.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/computers/{computer_id}/storage-reset": {
      "parameters": [
        { "name": "computer_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "resetComputerStorage",
        "summary": "Reserve a new empty Storage generation",
        "description": "Persists one CAS intent, stages generation+1, and quiesces the current Job. The old generation remains current until the bound agent positively verifies detach, quarantine, deletion, and absence; only then may L1 publish the replacement and restore the Computer's authoritative desired state.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intent_revision", "storage_id", "storage_generation", "idempotency_key"],
            "properties": {
              "intent_revision": { "type": "integer", "minimum": 1 },
              "storage_id": { "type": "string", "minLength": 1 },
              "storage_generation": { "type": "integer", "minimum": 1 },
              "idempotency_key": { "type": "string", "minLength": 1 }
            }
          } } }
        },
        "responses": {
          "200": {
            "description": "Identical reset replay; no second generation was reserved.",
            "headers": { "Idempotency-Replayed": { "schema": { "type": "boolean", "const": true } } },
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "202": {
            "description": "Reset reserved; reconfiguration_phase remains resetting until old-generation absence is verified.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/computers/{computer_id}/storage-generations": {
      "parameters": [
        { "name": "computer_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "listComputerStorageGenerations",
        "summary": "List current, staging, and retired Storage generations",
        "responses": {
          "200": {
            "description": "Generation-ordered Storage lifecycle evidence.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/ComputerStorageGenerationList" } } }
          },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/computers/{computer_id}/projections": {
      "parameters": [
        { "name": "computer_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "installComputerProjection",
        "summary": "Install the next immutable Job projection",
        "description": "One CAS intent stages the new Job. A running Computer enters projecting and internally quiesces its current observation without fabricating operator stop intent; repeating the same request after positive reap atomically transfers authority and advances applied_revision.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intent_revision", "storage_id", "storage_generation", "spec"],
            "properties": {
              "intent_revision": { "type": "integer", "minimum": 1 },
              "storage_id": { "type": "string", "minLength": 1 },
              "storage_generation": { "type": "integer", "minimum": 1 },
              "spec": { "$ref": "./common.v1.json#/components/schemas/JobSpec" }
            }
          } } }
        },
        "responses": {
          "202": {
            "description": "Projection intent accepted; phase and applied_revision show whether transfer is still waiting for quiescence.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/computers/{computer_id}/remove": {
      "parameters": [
        { "name": "computer_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "removeComputer",
        "summary": "Irreversibly foreclose a Computer's Jobs and attempts",
        "description": "CAS-records removed intent, revokes live attempt authority, and prevents every existing or future Job projection from being claimed. A bound current Job enters the ordinary durable service-removal directive protocol so authenticated agent cleanup releases its Slot; composite Storage cleanup is a later contract layer.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intent_revision", "storage_id", "storage_generation"],
            "properties": {
              "intent_revision": { "type": "integer", "minimum": 1 },
              "storage_id": { "type": "string", "minLength": 1 },
              "storage_generation": { "type": "integer", "minimum": 1 }
            }
          } } }
        },
        "responses": {
          "202": {
            "description": "Removal intent accepted and all Job start authority revoked.",
            "content": { "application/json": { "schema": { "$ref": "./common.v1.json#/components/schemas/Computer" } } }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/nodes": {
      "get": {
        "operationId": "listNodes",
        "summary": "List operator-visible nodes",
        "description": "Returns every registered node after applying liveness thresholds. Results are ordered by stable node ID.",
        "responses": {
          "200": {
            "description": "Current fleet state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["nodes"],
                  "properties": {
                    "nodes": {
                      "type": "array",
                      "items": { "$ref": "./common.v1.json#/components/schemas/Node" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/nodes/{node_id}/drain": {
      "parameters": [
        {
          "name": "node_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "post": {
        "operationId": "operatorDrainNode",
        "summary": "Stop new claims on a node",
        "description": "Disables claims as durable operator intent while allowing active attempt authority to finish. The mutation is revision-guarded and is valid for dead nodes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["claims_enabled", "intent_revision", "reason"],
                "properties": {
                  "claims_enabled": { "const": false },
                  "intent_revision": { "type": "integer", "minimum": 0 },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Claims are durably disabled; liveness state is unchanged.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Node" }
              }
            }
          },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/nodes/{node_id}/claims": {
      "parameters": [
        {
          "name": "node_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "post": {
        "operationId": "setNodeClaims",
        "summary": "Set durable node claim intent",
        "description": "Atomically enables or disables new claims when intent_revision matches. Liveness does not gate the write, and changing intent does not fence active attempts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["claims_enabled", "intent_revision", "reason"],
                "properties": {
                  "claims_enabled": { "type": "boolean" },
                  "intent_revision": { "type": "integer", "minimum": 0 },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated node intent and projection.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Node" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/jobs/{job_id}/prompt": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "post": {
