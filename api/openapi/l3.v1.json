{
  "openapi": "3.1.0",
  "info": {
    "title": "Wefty L3 run-ledger API",
    "version": "0.1.0-prerelease",
    "description": "Caller run submission/polling and run-token-scoped workflow writes. Every request is Fabric-authenticated. Requests without a bearer run token additionally require the tag:wefty-client Fabric principal; bearer authorization is always interpreted as an opaque run token."
  },
  "servers": [{ "url": "wefty://run-ledger" }],
  "paths": {
    "/v1/workflows/{workflow_id}/versions": {
      "parameters": [
        {
          "name": "workflow_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
        }
      ],
      "post": {
        "operationId": "createWorkflowVersion",
        "summary": "Append an immutable saved workflow version",
        "description": "The ledger assigns the next monotonically increasing version. Content, hash, interpreter, and mode cannot be updated or deleted after creation.",
        "security": [{ "fabricIdentity": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowVersionInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable workflow version created.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowVersion" } }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/workflows/{workflow_id}/versions/{version}": {
      "parameters": [
        {
          "name": "workflow_id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
        },
        {
          "name": "version",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^v[1-9][0-9]*$" }
        }
      ],
      "get": {
        "operationId": "getWorkflowVersion",
        "summary": "Read one immutable saved workflow version",
        "security": [{ "fabricIdentity": [] }],
        "responses": {
          "200": {
            "description": "Saved workflow version.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowVersion" } }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "operationId": "createRun",
        "summary": "Create a manual or child run",
        "description": "Exactly one of workflow_ref, inline_script, or image is required. workflow://<id> resolves the latest version and workflow://<id>/vN resolves an explicit version; every source is snapshotted onto the run before the run row and dispatch intent commit atomically. Image reruns reuse either the submitted digest or the write-once digest ingested from accepted L1 attempt evidence; they never resolve a tag again. L1 creation uses a stable dispatch key. max_cost is stored but not enforced in v0.1.",
        "security": [{ "fabricIdentity": [] }, { "fabricIdentity": [], "runToken": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["params"],
                "properties": {
                  "workflow_ref": {
                    "type": "string",
                    "pattern": "^workflow://[a-z0-9][a-z0-9._-]{0,127}(/v[1-9][0-9]*)?$"
                  },
                  "inline_script": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["content", "sha256"],
                    "properties": {
                      "content": { "type": "string", "minLength": 1 },
                      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                      "interpreter": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 1
                      },
                      "mode": { "type": "integer", "minimum": 0, "maximum": 4095, "default": 493 }
                    }
                  },
                  "image": { "$ref": "#/components/schemas/ImageProgram" },
                  "params": { "type": "object" },
                  "tags": {
                    "type": "array",
                    "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
                    "uniqueItems": true
                  },
                  "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "max_runtime_seconds": { "type": "integer", "minimum": 1 },
                      "max_cost": { "type": "number", "minimum": 0 }
                    }
                  },
                  "envelope_schema": {
                    "type": "object",
                    "description": "Restricted JSON Schema 2020-12 dialect. Local fragment references are allowed; remote references, dynamic references, vocabularies, and content decoders are forbidden."
                  },
                  "required_envelope": { "type": "boolean", "default": false },
                  "parent_run_id": { "type": "string" }
                },
                "oneOf": [
                  {
                    "required": ["workflow_ref"],
                    "not": {
                      "anyOf": [
                        { "required": ["inline_script"] },
                        { "required": ["image"] }
                      ]
                    }
                  },
                  {
                    "required": ["inline_script"],
                    "not": {
                      "anyOf": [
                        { "required": ["workflow_ref"] },
                        { "required": ["image"] }
                      ]
                    }
                  },
                  {
                    "required": ["image"],
                    "not": {
                      "anyOf": [
                        { "required": ["workflow_ref"] },
                        { "required": ["inline_script"] }
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical idempotency replay; original run returned.",
            "headers": {
              "Idempotency-Replayed": { "schema": { "type": "boolean", "const": true } }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RunAccepted" } }
            }
          },
          "201": {
            "description": "Run and dispatch intent created.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RunAccepted" } }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": {
            "$ref": "./common.v1.json#/components/responses/NotFound",
            "description": "workflow_ref did not resolve."
          },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "422": { "$ref": "./common.v1.json#/components/responses/UnprocessableEntity" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "getRun",
        "summary": "Read a run record",
        "description": "Run tokens may read their own run and descendants, never siblings or ancestors.",
        "security": [{ "fabricIdentity": [] }, { "fabricIdentity": [], "runToken": [] }],
        "responses": {
          "200": {
            "description": "Run ledger record.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/RunRecord" }
              }
            }
          },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" }
        }
      }
    },
    "/v1/runs/{run_id}/lineage": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "getRunLineage",
        "summary": "Read ancestor and descendant run lineage",
        "description": "Ancestors are root-first and descendants are depth-first. A run token receives only entries within its own descendant scope and cannot query an ancestor or sibling target.",
        "security": [{ "fabricIdentity": [] }, { "fabricIdentity": [], "runToken": [] }],
        "responses": {
          "200": {
            "description": "Queryable run lineage.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RunLineage" } }
            }
          },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" }
        }
      }
    },
    "/v1/runs/{run_id}/execution": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "getRunExecution",
        "summary": "Inspect L1 execution through its owning run",
        "description": "Projects durable L3 dispatch attempts and structured error together with the redacted L1 job and retained attempt evidence. The surface remains run-keyed and exposes no generic job namespace.",
        "security": [{ "fabricIdentity": [] }, { "fabricIdentity": [], "runToken": [] }],
        "responses": {
          "200": {
            "description": "Cross-layer execution diagnostics.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RunExecution" } }
            }
          },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/runs/{run_id}/rerun": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } },
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
        }
      ],
      "post": {
        "operationId": "rerunRun",
        "summary": "Create a new run from a stored run snapshot",
        "description": "Copies the source run's immutable program fields, params, tags, limits, and envelope requirements. A tag-only image source gains only the write-once top-level digest previously ingested from accepted L1 attempt evidence; unresolved sources fail with no_resolved_image_snapshot and no tag is resolved again. Saved Workflow refs are never re-resolved. Trigger provenance records rerun and the source run ID. The source must carry exactly one reserved wefty:node:<stable-node-id> tag; the rerun reuses its node-local handoff directory and otherwise fails explicitly.",
        "security": [{ "fabricIdentity": [] }],
        "responses": {
          "200": {
            "description": "Identical idempotency replay; the previously created rerun is returned.",
            "headers": {
              "Idempotency-Replayed": { "schema": { "type": "boolean", "const": true } }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RunAccepted" } }
            }
          },
          "201": {
            "description": "New run and dispatch intent created from the stored snapshot.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RunAccepted" } }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" },
          "500": { "$ref": "./common.v1.json#/components/responses/Internal" }
        }
      }
    },
    "/v1/runs/{run_id}/logs": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "getRunLogs",
        "summary": "Poll the run's L1 logs",
        "security": [{ "fabricIdentity": [] }, { "fabricIdentity": [], "runToken": [] }],
        "parameters": [
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 200 } }
        ],
        "responses": {
          "200": {
            "description": "Log page.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/LogPage" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" }
        }
      }
    },
    "/v1/runs/{run_id}/envelopes": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "appendEnvelope",
        "summary": "Append a validated, idempotent step envelope",
        "description": "Only the run's attempt-bound run token may write. The base schema and caller-provided restricted schema both validate before append. Invalid writes are stored as immutable protocol rejections and fail the run.",
        "security": [{ "fabricIdentity": [], "runToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnvelopeWrite" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical idempotency replay; the original envelope is returned.",
            "headers": {
              "Idempotency-Replayed": { "schema": { "type": "boolean", "const": true } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Envelope" }
              }
            }
          },
          "201": {
            "description": "Envelope appended.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/Envelope" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/runs/{run_id}/gates": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "appendGateResult",
        "summary": "Append an idempotent workflow-evaluated gate result",
        "description": "L3 stores gate outcomes; the workflow, not L3, evaluates the gate. Invalid writes are stored as protocol rejections, and fail/error outcomes fail the run.",
        "security": [{ "fabricIdentity": [], "runToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GateResultWrite" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical idempotency replay; the original gate result is returned.",
            "headers": {
              "Idempotency-Replayed": { "schema": { "type": "boolean", "const": true } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/GateResult" }
              }
            }
          },
          "201": {
            "description": "Gate result appended.",
            "content": {
              "application/json": {
                "schema": { "$ref": "./common.v1.json#/components/schemas/GateResult" }
              }
            }
          },
          "400": { "$ref": "./common.v1.json#/components/responses/BadRequest" },
          "401": { "$ref": "./common.v1.json#/components/responses/Unauthorized" },
          "403": { "$ref": "./common.v1.json#/components/responses/Forbidden" },
          "404": { "$ref": "./common.v1.json#/components/responses/NotFound" },
          "409": { "$ref": "./common.v1.json#/components/responses/Conflict" }
        }
      }
    },
    "/v1/runs/{run_id}/cancel": {
      "parameters": [
        { "name": "run_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "operationId": "cancelRun",
        "summary": "Reserved run cancellation",
        "description": "Always returns 501 in v0.1 and does not mutate run or job state.",
        "security": [{ "fabricIdentity": [] }, { "fabricIdentity": [], "runToken": [] }],
        "x-wefty-implementation": "reserved",
        "responses": {
          "501": { "$ref": "./common.v1.json#/components/responses/NotImplemented" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WorkflowVersionInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "interpreter": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "mode": { "type": "integer", "minimum": 0, "maximum": 4095, "default": 493 },
          "image": { "$ref": "#/components/schemas/ImageProgram" }
        },
        "oneOf": [
          {
            "required": ["content", "sha256"],
            "not": { "required": ["image"] }
          },
          {
            "required": ["image"],
            "properties": { "image": { "required": ["digest"] } },
            "not": {
              "anyOf": [
                { "required": ["content"] },
                { "required": ["sha256"] },
                { "required": ["interpreter"] },
                { "required": ["mode"] }
              ]
            }
          }
        ]
      },
      "WorkflowVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow_id", "version", "workflow_ref", "created_at"],
        "properties": {
          "workflow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "version": { "type": "integer", "minimum": 1 },
          "workflow_ref": {
            "type": "string",
            "pattern": "^workflow://[a-z0-9][a-z0-9._-]{0,127}/v[1-9][0-9]*$"
          },
          "content": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "interpreter": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
          "image": { "$ref": "#/components/schemas/ImageProgram" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "oneOf": [
          {
            "required": ["content", "sha256", "interpreter", "mode"],
            "not": { "required": ["image"] }
          },
          {
            "required": ["image"],
            "properties": { "image": { "required": ["digest"] } },
            "not": {
              "anyOf": [
                { "required": ["content"] },
                { "required": ["sha256"] },
                { "required": ["interpreter"] },
                { "required": ["mode"] }
              ]
            }
          }
        ]
      },
      "OCIContainerPath": {
        "type": "string",
        "pattern": "^/",
        "not": { "pattern": "(^|/)\\.\\.?(/|$)|//|.+/$" }
      },
      "OCINodePath": {
        "type": "string",
        "pattern": "^/",
        "not": { "pattern": "^/$|(^|/)\\.\\.?(/|$)|//|.+/$" }
      },
      "OCIMountContainerPath": {
        "allOf": [
          { "$ref": "#/components/schemas/OCIContainerPath" },
          {
            "not": {
              "anyOf": [
                { "enum": ["/", "/wefty", "/wefty/handoff", "/wefty/service"] },
                { "pattern": "^/wefty/(handoff|service)/" }
              ]
            }
          }
        ]
      },
      "ImageProgram": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference"],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:[0-9]+)?/)?[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*(/[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*)*(:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?$"
          },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "argv": {
            "type": "array",
            "minItems": 1,
            "contains": { "type": "string", "minLength": 1 },
            "items": { "type": "string" }
          },
          "working_directory": { "$ref": "#/components/schemas/OCIContainerPath" },
          "mounts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node_path", "container_path"],
              "properties": {
                "node_path": { "$ref": "#/components/schemas/OCINodePath" },
                "container_path": { "$ref": "#/components/schemas/OCIMountContainerPath" },
                "read_only": { "type": "boolean" }
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "memory_bytes": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
              "cpu_millicores": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
            }
          },
          "runtime_handler": { "type": "string", "maxLength": 128 }
        }
      },
      "RunAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "status_url", "logs_url"],
        "properties": {
          "run_id": { "type": "string" },
          "status_url": { "type": "string", "format": "uri" },
          "logs_url": { "type": "string", "format": "uri" }
        }
      },
      "RunExecution": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "dispatch_attempts"],
        "properties": {
          "run_id": { "type": "string" },
          "l1_job_id": { "type": "string" },
          "dispatch_attempts": { "type": "integer", "minimum": 0 },
          "dispatch_error": { "$ref": "./common.v1.json#/components/schemas/Error" },
          "job": { "$ref": "./common.v1.json#/components/schemas/Job" }
        }
      },
      "EnvelopeWrite": {
        "description": "Envelope append request. attempt_id may be omitted and is then bound from the authenticated run token; a supplied value must match that token.",
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "envelope_id", "idempotency_key", "run_id", "step_id", "status", "summary", "created_at"],
        "properties": {
          "schema_version": { "const": 1 },
          "envelope_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
          "run_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "step_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "attempt_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "status": { "enum": ["succeeded", "failed", "partial"] },
          "summary": { "type": "string", "minLength": 1 },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "uri"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "uri": { "type": "string", "minLength": 1 },
                "media_type": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          },
          "notes_for_next_agent": { "type": "string" },
          "extensions": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
            "additionalProperties": true
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "GateResultWrite": {
        "description": "Gate-result append request. attempt_id may be omitted and is then bound from the authenticated run token; a supplied value must match that token.",
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "gate_id", "idempotency_key", "run_id", "step_id", "name", "outcome", "evaluated_at"],
        "properties": {
          "schema_version": { "const": 1 },
          "gate_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
          "run_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "step_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "attempt_id": { "type": "string", "minLength": 1, "maxLength": 255 },
          "name": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["pass", "fail", "error", "skipped"] },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          },
          "evaluated_at": { "type": "string", "format": "date-time" }
        }
      },
      "LineageEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "status", "depth"],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "parent_run_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "dispatching", "queued", "running", "awaiting-input", "succeeded", "failed"] },
          "depth": { "type": "integer", "minimum": 1 }
        }
      },
      "RunLineage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "ancestors", "descendants"],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "ancestors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LineageEntry" }
          },
          "descendants": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LineageEntry" }
          }
        }
      }
    },
    "securitySchemes": {
      "fabricIdentity": { "$ref": "./common.v1.json#/components/securitySchemes/fabricIdentity" },
      "runToken": { "$ref": "./common.v1.json#/components/securitySchemes/runToken" }
    }
  }
}
