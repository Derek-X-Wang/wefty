# syntax=docker/dockerfile:1.18.0@sha256:dabfc0969b935b2080555ace70ee69a5261af8a8f1b4df97b9e7fbcf6722eddf

ARG DEBIAN_IMAGE=docker.io/library/debian@sha256:f324c7ff54321e8d9c588493a20244965938ce0aa50bbd1022d38010e9ffc4b1
FROM ${DEBIAN_IMAGE} AS neatvnc-mutation-build
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive
RUN case "$TARGETARCH" in amd64) ninja_version=1.12.1-1 ;; arm64) ninja_version=1.12.1-1+b1 ;; *) exit 64 ;; esac \
    && printf '%s\n' 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260827T000000Z trixie main' > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/* \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install --yes --no-install-recommends \
      build-essential=12.12 ca-certificates=20250419 curl=8.14.1-2+deb13u4 libaml-dev=0.3.0-3 \
      libdrm-dev=2.4.124-2 libgnutls28-dev=3.8.9-3+deb13u4 libpixman-1-dev=0.44.0-3 \
      libxxhash-dev=0.8.3-2 meson=1.7.0-1 nettle-dev=3.10.1-1 ninja-build="$ninja_version" \
      patch=2.8-2 pkgconf=1.8.1-4 xz-utils=5.8.1-1+deb13u1 zlib1g-dev=1:1.3.dfsg+really1.3.1-1+b1 \
    && curl --fail --location --retry 5 --output /tmp/neatvnc.tar.xz \
      https://snapshot.debian.org/archive/debian/20260827T000000Z/pool/main/n/neatvnc/neatvnc_0.9.1%2Bdfsg.orig.tar.xz \
    && printf '%s  %s\n' 46d689818d88e0d65387bf9182f1bd1015c4b28e0347696f0bec7c7d9c829194 /tmp/neatvnc.tar.xz | sha256sum --check -
COPY examples/computer-wayland/patches/neatvnc-rfb-websocket-v1.patch /tmp/neatvnc.patch
RUN mkdir /tmp/neatvnc \
    && tar --extract --xz --file /tmp/neatvnc.tar.xz --directory /tmp/neatvnc --strip-components=1 \
    && patch --directory /tmp/neatvnc --strip=1 < /tmp/neatvnc.patch \
    && meson setup /tmp/neatvnc/build /tmp/neatvnc --buildtype=release --prefix=/opt/neatvnc --libdir=lib \
      -Dtests=false -Dexamples=false -Dbenchmarks=false -Djpeg=disabled -Dtls=enabled -Dnettle=enabled \
      -Dgbm=disabled -Dh264=disabled -Dwefty_mutation_hooks=true \
    && meson compile -C /tmp/neatvnc/build \
    && meson install -C /tmp/neatvnc/build

ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ENV WEFTY_CONFORMANCE_MUTATION=text-frames-accepted
ENV WEFTY_COMPUTER_VIEW_PORT=9
COPY --from=neatvnc-mutation-build /opt/neatvnc/lib/libneatvnc.so.0.0.0 /usr/local/lib/libneatvnc.so.0.0.0
COPY --chmod=0755 examples/computer-wayland/entrypoint-fixture.sh /usr/local/bin/wefty-computer-wayland-entrypoint
COPY --chmod=0755 examples/computer-wayland/watch-driver-fixture.py /usr/local/libexec/wefty-watch-driver
USER 0
RUN ldconfig \
    && ldd /usr/bin/wayvnc | grep -F 'libneatvnc.so.0 => /usr/local/lib/libneatvnc.so.0'
USER 12000:12000
