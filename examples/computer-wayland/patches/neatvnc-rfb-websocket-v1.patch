--- a/src/server.c
+++ b/src/server.c
@@ -48,0 +49 @@ native-input-oracle-includes:
+#include <fcntl.h>
@@ -1001,0 +1003,27 @@ native-input-oracle:
+/* The image's conformance oracle records protocol input at the native RFB
+ * parser. Each wayvnc role opts in independently, so --disable-input remains
+ * the view-side enforcement point rather than a client-side filter. */
+static bool wefty_input_oracle_enabled(void)
+{
+	const char* enabled = getenv("WEFTY_WAYVNC_RECORD_INPUT");
+	return enabled && (strcmp(enabled, "control") == 0 ||
+			strcmp(enabled, "view") == 0);
+}
+
+static void wefty_record_input(const char* kind, uint16_t x, uint16_t y)
+{
+	if (!wefty_input_oracle_enabled())
+		return;
+
+	int fd = open("/tmp/wefty-computer/native-input-events",
+			O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+	if (fd < 0)
+		return;
+	if (strcmp(kind, "pointer") == 0)
+		dprintf(fd, "%s pointer %u %u\n",
+				getenv("WEFTY_WAYVNC_RECORD_INPUT"), x, y);
+	else
+		dprintf(fd, "%s key\n", getenv("WEFTY_WAYVNC_RECORD_INPUT"));
+	close(fd);
+}
+
@@ -1014,0 +1043 @@ native-input-oracle-key:
+	wefty_record_input("key", 0, 0);
@@ -1080,0 +1110 @@ native-input-oracle-pointer:
+	wefty_record_input("pointer", x, y);
