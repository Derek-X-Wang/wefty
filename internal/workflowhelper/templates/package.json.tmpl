{
  "name": "{{.PackageName}}",
  "version": "{{.PackageVersion}}",
  "private": true,
  "type": "module",
  "engines": {
    "node": "{{.NodeEngine}}"
  },
  "scripts": {
    "build": "esbuild src/{{.Name}}.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/{{.Name}}.mjs --banner:js='#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && go test . -count=1"
  },
  "devDependencies": {
{{- range $index, $pin := .Toolchain}}{{if $index}},{{end}}
    "{{$pin.Name}}": "{{$pin.Version}}"
{{- end}}
  }
}
