// {{.Name}}: a wefty workflow, scaffolded by `wefty workflow init`.
//
// What this workflow may do
// -------------------------
// It reports, and it uses no credential to do it. Everything below writes files
// into $WEFTY_RUN_DIR, the run mailbox; the node agent, which already holds
// authority, publishes them to the run ledger. A mailbox write is a claim about
// this run and nothing else -- it confers no authority over the cluster, so do
// not build on this workflow being able to dispatch a child run, read another
// run, or act on any other job.
//
// Contract: docs/contracts/run-execution-context.md, "Run mailbox".
//
// Why this file is one CommonJS file with JSDoc comments
// ------------------------------------------------------
// Read this before you reach for `const x: string`.
//
// A wefty submission carries one inline script, and the node materializes it
// as a file with NO extension and no package.json beside it. Every TypeScript
// runtime decides whether to strip types from the file extension -- verified:
// both `node --experimental-strip-types` and `tsx` refuse an extensionless
// file -- and an extensionless file with no package.json is loaded as
// CommonJS. So the runtime syntax here is what Node runs directly: `require`
// rather than `import`, and no type annotations. The JSDoc below is for
// readers; it is not checked by `tsc` in a .ts file.
//
// Annotation syntax, `import`, and a sibling module all make this file
// unsubmittable until wefty grows a multi-file or build-step submission path.
// If you want real TypeScript, write it elsewhere and build to one CommonJS
// file, then submit that.
//
// Replace the "do the work" section. Keep the reporting shape: one step
// bracketing the work, one envelope per unit of work, one gate carrying the
// verdict, one result document.

"use strict";

const { mkdirSync, openSync, writeSync, fsyncSync, closeSync, readFileSync, renameSync } = require("node:fs");
const { join } = require("node:path");

const WORKFLOW = "{{.Name}}";

// --------------------------------------------------------------------------
// Run mailbox writer
//
// It writes the same event files `wefty run ...` writes. Protocol:
// docs/contracts/run-execution-context.md, "Run mailbox".
// --------------------------------------------------------------------------

let sequence = 0;

/** @returns {string} */
function runDirectory() {
  const directory = (process.env.WEFTY_RUN_DIR || "").trim();
  if (directory === "") {
    throw new Error(
      "WEFTY_RUN_DIR is not set: this job has no run mailbox to report through. " +
        'See docs/contracts/run-execution-context.md, "Run mailbox".',
    );
  }
  return directory;
}

/**
 * A header value is one line: fold what a header cannot carry, drop the rest.
 * @param {string} value
 * @returns {string}
 */
function headerValue(value) {
  let folded = "";
  for (const character of value) {
    const code = character.codePointAt(0) || 0;
    if (character === "\n" || character === "\r" || character === "\t") {
      folded += " ";
    } else if (code >= 0x20 && code !== 0x7f) {
      folded += character;
    }
  }
  return folded.replace(/^ +/, "").replace(/ +$/, "");
}

/**
 * Create a new 0600 regular file and refuse an existing one -- a symlink
 * planted where the file was going to be included. Flush before the caller
 * renames it into place, so no reader sees a short file.
 * @param {string} directory
 * @param {string} name
 * @param {string} content
 */
function writeExclusive(directory, name, content) {
  const handle = openSync(join(directory, name), "wx", 0o600);
  try {
    writeSync(handle, content);
    fsyncSync(handle);
  } finally {
    closeSync(handle);
  }
}

/**
 * Write one event. Returns the published path.
 * @param {string} kind
 * @param {object} [options] name, step, status, outcome, summary, key, format, payload
 * @returns {string}
 */
function writeEvent(kind, options) {
  const chosen = options || {};
  const directory = runDirectory();
  const staging = join(directory, "tmp");
  const events = join(directory, "events");
  mkdirSync(staging, { recursive: true });
  mkdirSync(events, { recursive: true });

  // Nanoseconds, not seconds: the agent publishes a sweep in lexical order, so
  // the file name is what keeps two events written back to back in the order
  // the workflow reported them.
  sequence = (sequence + 1) % 10000;
  const label = chosen.name || chosen.step || kind;
  const slug = (label.replace(/[^A-Za-z0-9._-]/g, "-") || "event").slice(0, 32);
  const nanoseconds = process.hrtime.bigint
    ? (BigInt(Date.now()) * 1000000n + (process.hrtime.bigint() % 1000000n)).toString()
    : String(Date.now() * 1000000);
  const file =
    nanoseconds.padStart(19, "0") +
    "-" +
    String(sequence).padStart(4, "0") +
    "-" + kind + "-" + slug + "-" +
    process.pid.toString(16).padStart(8, "0");

  let document = "wefty-protocol: 1\nkind: " + kind + "\n";
  for (const [header, raw] of [
    ["name", chosen.name],
    ["step", chosen.step],
    ["status", chosen.status],
    ["outcome", chosen.outcome],
    ["summary", chosen.summary],
    ["key", chosen.key],
  ]) {
    const value = headerValue(raw || "");
    if (value !== "") {
      document += header + ": " + value + "\n";
    }
  }
  const createdAt = new Date().toISOString().replace(/\.\d{3}Z$/, "Z");
  document += "payload: " + (chosen.format || "text") + "\ncreated-at: " + createdAt + "\n--\n";
  document += chosen.payload || "";

  writeExclusive(staging, file, document);
  const published = join(events, file);
  renameSync(join(staging, file), published);
  return published;
}

/**
 * Bracket a step: start it, then end it.
 * @param {string} name
 * @param {object} [options] end, summary
 */
function step(name, options) {
  const chosen = options || {};
  return writeEvent("step", { name, status: chosen.end === true ? "ended" : "started", summary: chosen.summary });
}

/**
 * Report one step's outcome.
 * @param {string} stepID
 * @param {object} [options] status, summary, payload, format
 */
function envelope(stepID, options) {
  const chosen = options || {};
  return writeEvent("envelope", {
    step: stepID,
    status: chosen.status || "succeeded",
    summary: chosen.summary,
    payload: chosen.payload,
    format: chosen.format,
  });
}

/**
 * Record one verdict. Its evidence is the payload.
 * @param {string} name
 * @param {string} outcome pass, fail, error or skipped
 * @param {object} [options] summary, evidence
 */
function gate(name, outcome, options) {
  const chosen = options || {};
  return writeEvent("gate", { name, outcome, summary: chosen.summary, payload: chosen.evidence });
}

/**
 * Record the run's result document. It also lands in the handoff directory as
 * result.json -- written exclusively and renamed, for the same reason the
 * mailbox renames -- which is what an operator reads off the node when a
 * failing attempt retains its handoff.
 * @param {string} document
 * @param {object} [options] status, summary
 */
function result(document, options) {
  const chosen = options || {};
  const handoff = (process.env.WEFTY_HANDOFF_DIR || "").trim();
  if (handoff !== "") {
    mkdirSync(handoff, { recursive: true });
    const staged = ".result.json." + process.pid + "." + Date.now();
    writeExclusive(handoff, staged, document);
    renameSync(join(handoff, staged), join(handoff, "result.json"));
  }
  let format = "text";
  try {
    JSON.parse(document);
    format = "json";
  } catch {
    format = "text";
  }
  return writeEvent("result", { status: chosen.status || "succeeded", summary: chosen.summary, payload: document, format });
}

/**
 * One parameter as text, empty when it was not submitted. The agent delivers
 * params.json; a job never receives its own params in the environment.
 * @param {string} name
 * @returns {string}
 */
function param(name) {
  let params = {};
  try {
    params = JSON.parse(readFileSync(join(runDirectory(), "params.json"), "utf8"));
  } catch {
    // A run submitted without params, and one whose params were too large to
    // deliver, both leave the file absent. Neither is a workflow error.
    return "";
  }
  const value = params[name];
  if (value === undefined || value === null) {
    return "";
  }
  return typeof value === "string" ? value : JSON.stringify(value);
}

/** @param {string} message */
function log(message) {
  process.stdout.write(WORKFLOW + ": " + message + "\n");
}

// --------------------------------------------------------------------------
// Do the work
// --------------------------------------------------------------------------

const subject = param("subject") || "world";

step("work", { summary: "greeting " + subject });

const detail = "hello, " + subject + "\n";
const passed = detail.length > 0;
const workStatus = passed ? "succeeded" : "failed";
const outcome = passed ? "pass" : "fail";

envelope("work", { status: workStatus, summary: "greeted " + subject, payload: detail });
step("work", { end: true, summary: "greeting " + subject });
gate(WORKFLOW, outcome, { summary: "the greeting is " + outcome });

// JSON.stringify is what keeps a subject carrying a quote or a backslash from
// breaking the document.
result(JSON.stringify({ schema_version: 1, workflow: WORKFLOW, subject, passed }) + "\n", {
  status: workStatus,
  summary: WORKFLOW + " finished: " + outcome,
});

log("done: " + outcome);
process.exit(passed ? 0 : 1);
