{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wefty.dev/schemas/v1/job-spec.schema.json",
  "title": "Wefty Job Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dispatch_key", "kind", "class", "execution"],
  "properties": {
    "schema_version": { "const": 1 },
    "dispatch_key": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S" },
    "kind": {
      "description": "Open workload kind. Unknown values are valid data and are rejected only by agents that cannot execute them.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\s*\\S+\\s*$"
    },
    "class": {
      "description": "Open workload lifecycle class. Unknown values are valid data and are rejected only by agents that cannot execute them.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "runtime_handler": { "type": "string", "maxLength": 128, "pattern": "^\\s*(?:\\S+)?\\s*$" },
    "routing_tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
      "uniqueItems": true
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "inline_base64": { "type": "string", "contentEncoding": "base64" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "interpreter": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "mode": { "type": "integer", "minimum": 0, "maximum": 4095 }
          },
          "oneOf": [
            {
              "required": ["path"],
              "not": {
                "properties": { "inline_base64": true },
                "required": ["inline_base64"]
              }
            },
            {
              "required": ["inline_base64", "sha256"],
              "not": {
                "properties": { "path": true },
                "required": ["path"]
              }
            }
          ]
        },
        "argv": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "env": {
          "$ref": "#/$defs/environment"
        },
        "sensitive_env": {
          "description": "Environment values that must be redacted from logs and API responses.",
          "$ref": "#/$defs/environment"
        },
        "working_directory": { "type": "string", "minLength": 1 },
        "handoff_directory": { "type": "string", "minLength": 1 },
        "oci": { "$ref": "#/$defs/ociExecution" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_runtime_seconds": { "type": "integer", "minimum": 1 },
        "idle_timeout_seconds": { "type": "integer", "minimum": 1, "default": 600 },
        "completion_timeout_seconds": { "type": "integer", "minimum": 1, "default": 60 }
      }
    },
    "published_port": {
      "description": "Immutable Fabric-namespace port for a service, or null/absent for a portless service.",
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 65535
    },
    "restart": {
      "description": "Declared service restart mode. v1 supports only always.",
      "const": "always"
    },
    "max_restart_streak": {
      "description": "Optional maximum consecutive restartable terminations; omission means unlimited.",
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "pattern": "^\\s*[Pp][Rr][Oo][Cc][Ee][Ss][Ss]\\s*$" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "execution": {
            "required": ["executable", "argv", "working_directory"],
            "not": { "required": ["oci"] }
          },
          "runtime_handler": { "pattern": "^\\s*$" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "pattern": "^\\s*[Oo][Cc][Ii]\\s*$" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "execution": {
            "required": ["oci"],
            "not": {
              "anyOf": [
                { "required": ["executable"] },
                { "required": ["argv"] },
                { "required": ["working_directory"] },
                { "required": ["handoff_directory"] }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "execution": { "not": { "required": ["oci"] } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "process" },
          "class": { "const": "one-shot" }
        },
        "required": ["kind", "class"]
      },
      "then": {
        "properties": {
          "execution": { "required": ["handoff_directory"] }
        }
      }
    },
    {
      "if": {
        "properties": { "class": { "const": "service" } },
        "required": ["class"]
      },
      "then": { "required": ["restart"] }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "oci" },
          "class": { "not": { "const": "one-shot" } }
        },
        "required": ["kind", "class"]
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "oci": {
                "properties": {
                  "image": { "required": ["digest"] }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "oci" },
          "execution": {
            "properties": {
              "oci": {
                "properties": { "mounts": { "minItems": 1 } },
                "required": ["mounts"]
              }
            },
            "required": ["oci"]
          }
        },
        "required": ["kind", "execution"]
      },
      "then": {
        "required": ["routing_tags"],
        "properties": {
          "routing_tags": {
            "contains": { "type": "string", "pattern": "^wefty:node:[a-z0-9][a-z0-9._:-]*$" },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "environment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    },
    "containerPath": {
      "type": "string",
      "pattern": "^/",
      "not": { "pattern": "(^|/)\\.\\.?(/|$)|//|.+/$" }
    },
    "nodePath": {
      "type": "string",
      "pattern": "^/",
      "not": { "pattern": "^/$|(^|/)\\.\\.?(/|$)|//|.+/$" }
    },
    "mountContainerPath": {
      "allOf": [
        { "$ref": "#/$defs/containerPath" },
        {
          "not": {
            "anyOf": [
              { "enum": ["/", "/wefty", "/wefty/handoff", "/wefty/service"] },
              { "pattern": "^/wefty/(handoff|service)/" }
            ]
          }
        }
      ]
    },
    "ociExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference"],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:[0-9]+)?/)?[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*(/[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*)*(:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "contains": { "type": "string", "minLength": 1 },
          "items": { "type": "string" }
        },
        "working_directory": { "$ref": "#/$defs/containerPath" },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_path", "container_path"],
            "properties": {
              "node_path": { "$ref": "#/$defs/nodePath" },
              "container_path": { "$ref": "#/$defs/mountContainerPath" },
              "read_only": { "type": "boolean" }
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "memory_bytes": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
            "cpu_millicores": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
          }
        }
      }
    }
  }
}
