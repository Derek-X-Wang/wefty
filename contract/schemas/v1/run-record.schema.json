{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wefty.dev/schemas/v1/run-record.schema.json",
  "title": "Wefty Run Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "dispatch_key",
    "status",
    "trigger",
    "workflow",
    "params",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/id" },
    "l1_job_id": { "$ref": "#/$defs/id" },
    "node_id": { "$ref": "#/$defs/id" },
    "parent_run_id": { "$ref": "#/$defs/id" },
    "dispatch_key": { "$ref": "#/$defs/id" },
    "status": {
      "enum": ["pending", "dispatching", "queued", "running", "awaiting-input", "succeeded", "failed"]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "principal"],
      "properties": {
        "type": { "enum": ["manual", "chain", "rerun"] },
        "principal": { "type": "string", "minLength": 1 },
        "source_run_id": { "$ref": "#/$defs/id" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_ref": { "type": "string", "minLength": 1 },
        "inline_script": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content", "sha256"],
          "properties": {
            "content": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "image": { "$ref": "#/$defs/imageProgram" }
      },
      "oneOf": [
        {
          "required": ["workflow_ref"],
          "not": {
            "anyOf": [
              { "required": ["inline_script"] },
              { "required": ["image"] }
            ]
          }
        },
        {
          "required": ["inline_script"],
          "not": {
            "anyOf": [
              { "required": ["workflow_ref"] },
              { "required": ["image"] }
            ]
          }
        },
        {
          "required": ["image"],
          "not": {
            "anyOf": [
              { "required": ["workflow_ref"] },
              { "required": ["inline_script"] }
            ]
          }
        }
      ]
    },
    "params": { "type": "object" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_runtime_seconds": { "type": "integer", "minimum": 1 },
        "max_cost": { "type": "number", "minimum": 0 }
      }
    },
    "envelopes": {
      "type": "array",
      "items": { "$ref": "envelope.schema.json" }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "gate-result.schema.json" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "imageProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:[0-9]+)?/)?[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*(/[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*)*(:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?$"
        },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "working_directory": { "type": "string", "pattern": "^/([^/]+(/[^/]+)*)?$" },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_path", "container_path"],
            "properties": {
              "node_path": { "type": "string", "pattern": "^/[^/]+(/[^/]+)*$" },
              "container_path": { "type": "string", "pattern": "^/[^/]+(/[^/]+)*$" },
              "read_only": { "type": "boolean", "default": false }
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "memory_bytes": { "type": "integer", "minimum": 1 },
            "cpu_millicores": { "type": "integer", "minimum": 1 }
          }
        },
        "runtime_handler": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
