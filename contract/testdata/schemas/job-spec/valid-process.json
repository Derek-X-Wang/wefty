{
  "schema_version": 1,
  "dispatch_key": "run_01JZK0:root",
  "kind": "process",
  "class": "one-shot",
  "routing_tags": ["arch:arm64", "os:darwin"],
  "execution": {
    "executable": { "path": "/usr/bin/git" },
    "argv": ["git", "status", "--short"],
    "env": { "WEFTY_RUN_ID": "run_01JZK0" },
    "sensitive_env": { "WEFTY_RUN_TOKEN": "secret-token" },
    "working_directory": "/workspace/wefty",
    "handoff_directory": "/workspace/.wefty/handoff"
  },
  "limits": {
    "max_runtime_seconds": 3600,
    "idle_timeout_seconds": 600,
    "completion_timeout_seconds": 60
  },
  "labels": { "run_id": "run_01JZK0" }
}
