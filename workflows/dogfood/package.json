{
  "name": "@wefty/dogfood-workflow",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/dogfood-workflow.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/dogfood-workflow.mjs --banner:js='#!/usr/bin/env node'",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && go test . -run TestDogfoodWorkflowContractSmoke -count=1"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@standard-schema/spec": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
